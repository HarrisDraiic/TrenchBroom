#include "@CMAKE_BINARY_DIR@/lib/TbUiLib/generated/ui/Version.h"

AAAAAAAA                ICON                    "@TB_RESOURCE_DIR@/win32/icons/AppIcon.ico"
APPICON                 ICON                    "@TB_RESOURCE_DIR@/win32/icons/DocIcon.ico"

1 VERSIONINFO
 FILEVERSION VERSION_WIN_RC
 PRODUCTVERSION VERSION_WIN_RC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@TB_PRODUCT_VENDOR@"
            VALUE "FileDescription", "@TB_PRODUCT_DESCRIPTION@"
            VALUE "FileVersion", VERSION_WIN_RC
            VALUE "InternalName", "@TB_PRODUCT_EXECUTABLE_NAME@.exe"
            VALUE "LegalCopyright", "Copyright (C) 2010"
            VALUE "OriginalFilename", "@TB_PRODUCT_EXECUTABLE_NAME@.exe"
            VALUE "ProductName", "@TB_PRODUCT_DISPLAY_NAME@"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
